        "it": { "stringUnit": { "state": "translated", "value": "Salvati" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Đã lưu" } }
      }
    },
    "bookmarks.empty.title": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "No saved listings yet" } },
        "de": { "stringUnit": { "state": "translated", "value": "Noch keine gespeicherten Inserate" } },
