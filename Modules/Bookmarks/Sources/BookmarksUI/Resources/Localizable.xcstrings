    "bookmarks.empty.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Tap the heart on a listing to keep it here." } },
        "de": { "stringUnit": { "state": "translated", "value": "Tippen Sie auf das Herz eines Inserats, um es hier zu behalten." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Touchez le cœur d'une annonce pour la garder ici." } },
        "it": { "stringUnit": { "state": "translated", "value": "Tocca il cuore di un annuncio per tenerlo qui." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Chạm vào trái tim trên một tin để giữ nó ở đây." } }
      }
    },
